# ------------------------------------------------------------------
# Jimscaling site (GitHub Reboot) - environment variables
# Copy to .env for local development. On Railway, set every variable
# below in Service > Variables (the root .env is never committed).
# ------------------------------------------------------------------

# ---- Jimmy AI chat (existing) ----
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
PORT=3001

# ---- Lead capture / free resource delivery ----
# Baserow (lead storage)
# API token: Baserow dashboard > user menu (bottom-left) > Settings >
# API tokens > copy a token that has access to the database below.
BASEROW_API_TOKEN=
# Hosted Baserow API endpoint. Keep this default unless self-hosting.
BASEROW_API_URL=https://api.baserow.io/api
# From the table's browser URL:
#   https://baserow.io/database/<BASEROW_DATABASE_ID>/table/<BASEROW_TABLE_ID>/...
BASEROW_DATABASE_ID=
BASEROW_TABLE_ID=

# Resend (email delivery + contact management)
# API key: https://resend.com/api-keys > Create API Key (Sending access).
RESEND_API_KEY=
# Must be a verified "From" address (Resend > Domains > verify your
# domain DNS records). Sending from an unverified sender is rejected.
RESEND_FROM_EMAIL=strategy@jimscaling.online
RESEND_FROM_NAME=Jimscaling Strategy
# Audience for contact records: Resend > Audiences > open your audience;
# the id is in the URL: .../audiences/<RESEND_AUDIENCE_ID>.
# Optional - contact sync is skipped when empty.
RESEND_AUDIENCE_ID=

# The free resource (Google Drive PDF, intentionally public)
# Provide the file ID and/or the share URL. The system derives the
# remaining URLs automatically from any one of these three values.
RESOURCE_TITLE=Free Resources
GOOGLE_DRIVE_FILE_ID=
RESOURCE_VIEW_URL=
RESOURCE_DOWNLOAD_URL=

# Site
SITE_URL=http://localhost:3000
# Subject line of the delivery email (configurable)
EMAIL_SUBJECT=Your Free Resource Is Ready

# Optional tuning (defaults shown in parentheses)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000
DEDUP_WINDOW_MS=1800000