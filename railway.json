{
  "$schema": "https://railway.com/railway.schema.json",
  "services": [
    {
      "name": "webesit",
      "projectPath": ".",
      "build": {
        "builder": "NIXPACKS",
        "buildCommand": "npm run build"
      },
      "deploy": {
        "startCommand": "npm start"
      }
    },
    {
      "name": "lead-capture",
      "projectPath": "lead-capture",
      "build": {
        "builder": "NIXPACKS",
        "buildCommand": "npm run build"
      },
      "deploy": {
        "startCommand": "npm start",
        "healthcheckPath": "/api/health",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      }
    }
  ]
}